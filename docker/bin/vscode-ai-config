#!/bin/bash
# vscode-ai-config: point the Cline and Roo Code VS Code extensions (running in
# this container through Dev Containers) at the same models as OpenCode.
#
#   default model   OPENCODE_MODEL           (Cline: Act mode, Roo: code/orchestrator/ask)
#   plan model      VSCODE_PLAN_MODEL        (Cline: Plan mode, Roo: architect/debug;
#                                            defaults to the model above)
#
# Models come from .env through docker compose: local Ollama models, or the
# single model behind a cloud endpoint (any OpenAI-compatible provider).
# Runs at every container start.
# Cline: seeds ~/.cline/data/{globalState,secrets}.json, but only when the .env
# values changed since the last seed, so choices made in Cline's UI survive.
# Roo Code: writes ~/.config/android-editor/roo-code-settings.json, which Roo
# imports on startup (roo-cline.autoImportSettingsPath, set in devcontainer.json).
set -euo pipefail

BACKEND="${LLM_BACKEND:-local}"
[ "$BACKEND" = runpod ] && BACKEND=cloud
HOST="${OLLAMA_HOST:-http://ollama:11434}"
case "$HOST" in http://*|https://*) ;; *) HOST="http://$HOST" ;; esac
CTX="${VSCODE_NUM_CTX:-${OLLAMA_NUM_CTX:-32768}}"
strip() { local m="${1:-}"; echo "${m#ollama/}"; }
# When using a cloud endpoint, both Cline/Roo modes use its one model,
# reached as an OpenAI-compatible provider. Any provider works; legacy
# RUNPOD_LLM_* are read when CLOUD_LLM_* are empty.
if [ "$BACKEND" = cloud ]; then
  CLOUD_URL="${CLOUD_LLM_URL:-${RUNPOD_LLM_URL:-}}"; [ -n "$CLOUD_URL" ] || { echo "CLOUD_LLM_URL unset" >&2; exit 1; }
  CLOUD_KEY="${CLOUD_LLM_KEY:-${RUNPOD_LLM_KEY:-}}"
  CLOUD_ID="${CLOUD_LLM_MODEL:-${RUNPOD_LLM_MODEL:-}}"; [ -n "$CLOUD_ID" ] || { echo "CLOUD_LLM_MODEL unset" >&2; exit 1; }
fi
DEFAULT="${OPENCODE_MODEL:-ollama/qwen3:14b}"
# Cline's Plan mode and Roo's architect/debug modes call tools (they read files),
# so they cannot use a model without tool-calling support. Default them to the
# main model; VSCODE_PLAN_MODEL overrides.
FALLBACK="${VSCODE_PLAN_MODEL:-$DEFAULT}"
# Roo modes that use the second-opinion model. Clear it to keep every mode on
# the default model (needed if the fallback model cannot call tools).
REASONER_MODES="${ROO_REASONER_MODES-architect debug}"

if [ "$BACKEND" = cloud ]; then D_ID="$CLOUD_ID"; F_ID="$CLOUD_ID"; else D_ID="$(strip "$DEFAULT")"; F_ID="$(strip "$FALLBACK")"; fi

# ------------------------------------------------------------------ Roo Code
ROO="$HOME/.config/android-editor/roo-code-settings.json"
mkdir -p "$(dirname "$ROO")"
profile() { # id model
  if [ "$BACKEND" = cloud ]; then
    jq -n --arg id "$1" --arg m "$CLOUD_ID" --arg u "$CLOUD_URL" --arg k "$CLOUD_KEY" '{id:$id, apiProvider:"openai", openAiModelId:$m, openAiBaseUrl:$u, openAiApiKey:$k, openAiStreamingEnabled:true}'
  else
    jq -n --arg id "$1" --arg m "$2" --arg u "$HOST" --argjson c "$CTX" '{id:$id, apiProvider:"ollama", ollamaModelId:$m, ollamaBaseUrl:$u, ollamaNumCtx:$c}'
  fi
}
default_name="Default: $D_ID"; fallback_name="Second opinion: $F_ID"
configs=$(jq -n \
  --arg dn "$default_name" --argjson d "$(profile ae-default "$D_ID")" \
  --arg fn "$fallback_name" --argjson f "$(profile ae-fallback "$F_ID")" \
  '{($dn): $d, ($fn): $f}')
modes=$(jq -n --arg r "$REASONER_MODES" '[$r | splits(" +") | select(length > 0)] | map({key: ., value: "ae-fallback"}) | from_entries
  | {code: "ae-default", orchestrator: "ae-default", ask: "ae-default"} + .')
jq -n --arg cur "$default_name" --argjson cfg "$configs" --argjson modes "$modes" '{
  providerProfiles: { currentApiConfigName: $cur, apiConfigs: $cfg, modeApiConfigs: $modes },
  globalSettings: {}
}' > "$ROO.tmp" && mv "$ROO.tmp" "$ROO" && chmod 600 "$ROO"

# ------------------------------------------------------------------ Cline
CL="$HOME/.cline/data"; mkdir -p "$CL"
seed=$(printf 'v4|%s|%s|%s|%s|%s' "$BACKEND" "$DEFAULT" "$FALLBACK" "${CLOUD_URL:-$HOST}" "$CTX" | sha256sum | cut -c1-16)
if [ "$(cat "$CL/.android-editor-seed" 2>/dev/null)" != "$seed" ]; then
  [ -s "$CL/globalState.json" ] || echo '{}' > "$CL/globalState.json"
  mode_keys() { # plan|act id
    if [ "$BACKEND" = cloud ]; then
      jq -n --arg p "$1" --arg m "$CLOUD_ID" '{($p+"ModeApiProvider"): "openai", ($p+"ModeOpenAiModelId"): $m}'
    else
      jq -n --arg p "$1" --arg m "$2" '{($p+"ModeApiProvider"): "ollama", ($p+"ModeOllamaModelId"): $m}'
    fi
  }
  conn=$([ "$BACKEND" = cloud ] \
     && jq -n --arg u "$CLOUD_URL" '{openAiBaseUrl: $u, welcomeViewCompleted: true}' \
     || jq -n --arg u "$HOST" --arg c "$CTX" '{ollamaBaseUrl: $u, ollamaApiOptionsCtxNum: $c, welcomeViewCompleted: true}')
  jq --argjson act "$(mode_keys act "$D_ID")" --argjson plan "$(mode_keys plan "$F_ID")" --argjson conn "$conn" \
     '. + $act + $plan + $conn' \
     "$CL/globalState.json" > "$CL/globalState.json.tmp" && mv "$CL/globalState.json.tmp" "$CL/globalState.json"
  [ -s "$CL/secrets.json" ] || echo '{}' > "$CL/secrets.json"
  if [ "$BACKEND" = cloud ]; then
    jq --arg k "$CLOUD_KEY" '. + {openAiApiKey: $k}' "$CL/secrets.json" > "$CL/secrets.json.tmp"
  else
    jq 'del(.apiKey, .openAiApiKey)' "$CL/secrets.json" > "$CL/secrets.json.tmp"
  fi
  mv "$CL/secrets.json.tmp" "$CL/secrets.json"; chmod 600 "$CL/secrets.json"
  echo "$seed" > "$CL/.android-editor-seed"
  echo "cline: Act = $D_ID, Plan = $F_ID"
else
  echo "cline: unchanged since last seed (UI choices kept)"
fi
echo "roo code: profiles in $ROO (code/orchestrator/ask -> $D_ID${REASONER_MODES:+, $REASONER_MODES -> $F_ID})"
