#!/usr/bin/env bash
# android-full-backup: snapshot an Android device over adb before flashing.
#
#   android-full-backup -s SERIAL [-o OUTDIR] [--no-userdata] [--no-bugreport]
#
# Always: device info (props, settings, package list, partition map), shared
# storage, user-installed APKs, bugreport.
# With root (Magisk/su over adb): a raw image of every partition (userdata
# compressed, skip it with --no-userdata) verified against on-device sha256,
# and a tar of /data (app data, accounts, Magisk) with SELinux labels when
# the device's tar supports it.
# Without root: `adb backup -all -apk` as the best available fallback.
#
# Works from the dev container or from a Mac (ADB=/path/to/adb). Nothing is
# written to the device except a uiautomator dump used to confirm adb backup.
set -euo pipefail

ADB=${ADB:-adb}
SERIAL=""; OUT=""; WANT_USERDATA=1; WANT_BUGREPORT=1
while [ $# -gt 0 ]; do
  case "$1" in
    -s) SERIAL=$2; shift 2 ;;
    -o) OUT=$2; shift 2 ;;
    --no-userdata) WANT_USERDATA=0; shift ;;
    --no-bugreport) WANT_BUGREPORT=0; shift ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
[ -n "$SERIAL" ] || { echo "usage: android-full-backup -s SERIAL [-o OUTDIR]" >&2; exit 2; }

# stdin from /dev/null: adb would otherwise swallow the file a `while read` loop is iterating
a() { "$ADB" -s "$SERIAL" "$@" </dev/null; }
ash() { a shell "$@"; }
h256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
human() { awk -v b="$1" 'BEGIN{s="B KB MB GB TB"; split(s,u," "); i=1; while (b>=1024 && i<5){b/=1024;i++} printf "%.1f %s", b, u[i]}'; }

state=$(a get-state 2>/dev/null || true)
[ "$state" = "device" ] || { echo "device $SERIAL is not in adb 'device' state (got '${state:-none}')" >&2; exit 1; }

model=$(ash getprop ro.product.model | tr -d '\r' | tr ' /' '__')
if [ -z "$OUT" ]; then OUT="backups/${model}-${SERIAL}-$(date +%Y%m%d-%H%M)"; fi
mkdir -p "$OUT"/info "$OUT"/sdcard "$OUT"/apks
OUT=$(cd "$OUT" && pwd)
LOG="$OUT/backup.log"
log() { printf '%s  %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG"; }
log "backup of $model ($SERIAL) -> $OUT"

# ---------------------------------------------------------------- 1. info
log "device info"
ash getprop | tr -d '\r' > "$OUT/info/getprop.txt"
for ns in system secure global; do ash settings list $ns | tr -d '\r' > "$OUT/info/settings-$ns.txt"; done
ash pm list packages -f | tr -d '\r' | sort > "$OUT/info/packages.txt"
ash pm list packages -3 | tr -d '\r' | sort > "$OUT/info/packages-third-party.txt"
ash pm list packages -d | tr -d '\r' | sort > "$OUT/info/packages-disabled.txt"
ash dumpsys package 2>/dev/null | tr -d '\r' > "$OUT/info/dumpsys-package.txt" || true
ash df -h | tr -d '\r' > "$OUT/info/df.txt"
ash cat /proc/mounts | tr -d '\r' > "$OUT/info/mounts.txt"
ash dumpsys battery | tr -d '\r' > "$OUT/info/battery.txt"
ash 'cat /system/build.prop /vendor/build.prop /product/build.prop 2>/dev/null' | tr -d '\r' > "$OUT/info/build.prop.txt" || true

# ---------------------------------------------------------------- 2. root?
ROOT=0
if ash 'su -c id' 2>/dev/null | grep -q 'uid=0'; then ROOT=1; log "root: yes (su works over adb)"; else log "root: no"; fi
su_() { ash "su -c '$*'"; }

# partition map
if [ $ROOT = 1 ]; then
  byname=$(su_ 'ls -d /dev/block/by-name /dev/block/platform/*/by-name 2>/dev/null; true' | tr -d '\r' | head -1)
  su_ "for l in $byname/*; do n=\$(basename \$l); t=\$(readlink -f \$l); s=\$(blockdev --getsize64 \$t 2>/dev/null); echo \"\$n \$t \$s\"; done" | tr -d '\r' > "$OUT/info/partitions.txt"
else
  byname=$(ash 'ls -d /dev/block/by-name /dev/block/platform/*/by-name 2>/dev/null; true' | tr -d '\r' | head -1)
  ash "ls -l $byname" | tr -d '\r' > "$OUT/info/partitions.txt" || true
fi
log "partition map: $(grep -c '' "$OUT/info/partitions.txt") entries"

# ---------------------------------------------------------------- 3. shared storage
log "shared storage (/storage/emulated/0)"
a pull /storage/emulated/0 "$OUT/sdcard" >> "$LOG" 2>&1 || log "  (some files could not be pulled, see log)"
log "  $(du -sh "$OUT/sdcard" | cut -f1)"

# ---------------------------------------------------------------- 4. user-installed APKs
log "user-installed APKs"
while read -r pkg; do
  pkg=${pkg#package:}; [ -n "$pkg" ] || continue
  mkdir -p "$OUT/apks/$pkg"
  ash pm path "$pkg" | tr -d '\r' | sed 's/^package://' | while read -r p; do
    [ -n "$p" ] && a pull "$p" "$OUT/apks/$pkg/" >/dev/null 2>&1 || log "  could not pull $p"
  done
done < "$OUT/info/packages-third-party.txt"
log "  $(ls "$OUT/apks" | wc -l | tr -d ' ') packages, $(du -sh "$OUT/apks" | cut -f1)"

# ---------------------------------------------------------------- 5. raw partitions (root)
# Each partition is read in 256 MiB chunks (dd skip/count) streamed out raw
# (phone-side gzip is several times slower than adb itself) and compressed
# here. A chunk that arrives short is retried, and if the device drops off adb
# mid-way we wait for it to come back, so a flaky cable or a shared adb server
# costs one chunk, not the partition. Chunks already on disk from an earlier
# run are reused. They are concatenated into one multi-member .img.gz and the
# whole image is checked against the device's own sha256; verified images are
# skipped on re-runs.
BS=4194304; CHUNK_BLOCKS=64
# A phone->Mac transfer over adb can wedge mid-stream: on Wi-Fi a brief link blip
# (a roam, a background scan, jitter) half-opens the socket, so dd's bytes stop
# arriving but `exec-out` never errors and blocks forever -- and the retry/wait
# loop below only runs *between* chunks, so it never gets to fire. pull_stream
# guards a transfer by killing it once its output has not grown for STALL_SECS,
# so the retry loop can reset the link and re-pull. (macOS has no `timeout`.)
STALL_SECS=${STALL_SECS:-45}
is_tcp() { case "$SERIAL" in *:*) return 0 ;; *) return 1 ;; esac; }
reset_transport() { # clear a wedged adb transport before retrying
  if is_tcp; then "$ADB" disconnect "$SERIAL" >/dev/null 2>&1; "$ADB" connect "$SERIAL" >/dev/null 2>&1
  else "$ADB" reconnect >/dev/null 2>&1 || true; fi
}
pull_stream() { # out-file  exec-out-arg  ->  0 ok, 124 stalled & killed, else exec-out rc
  local out=$1 arg=$2 pid last=0 stall=0 cur
  "$ADB" -s "$SERIAL" exec-out "$arg" > "$out" 2>/dev/null </dev/null &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 5
    cur=$( (wc -c < "$out" 2>/dev/null || echo 0) | tr -d ' ' ); cur=${cur:-0}
    if [ "$cur" -gt "$last" ]; then last=$cur; stall=0
    else
      stall=$((stall + 5))
      [ "$stall" -ge "$STALL_SECS" ] && { kill -TERM "$pid" 2>/dev/null; sleep 1; kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 124; }
    fi
  done
  wait "$pid" 2>/dev/null
}
wait_for_device() {
  local n=0
  while [ "$(a get-state 2>/dev/null | tr -d '\r')" != device ]; do
    [ $n = 0 ] && log "  device is not on adb; waiting for it to come back"
    n=$((n + 1)); [ $n -gt 200 ] && { log "  !! device gone for 10 minutes, giving up"; return 1; }
    sleep 3
  done
  [ $n -gt 0 ] && log "  device is back"
  return 0
}
dump_partition() { # name dev size -> 0 on success
  local name=$1 dev=$2 size=$3
  local out="$OUT/partitions/$name.img.gz" tmpd="$OUT/partitions/.$name.parts"
  mkdir -p "$tmpd"
  local nblocks=$(( (size + BS - 1) / BS )) i=0 part=0
  local nparts=$(( (nblocks + CHUNK_BLOCKS - 1) / CHUNK_BLOCKS ))
  while [ $i -lt $nblocks ]; do
    local count=$CHUNK_BLOCKS; [ $((i + count)) -gt $nblocks ] && count=$((nblocks - i))
    local expect=$(( count * BS )); [ $(( (i + count) * BS )) -gt $size ] && expect=$(( size - i * BS ))
    local f; f="$tmpd/$(printf '%05d' $part).gz"
    if [ -s "$f" ] && gzip -t "$f" 2>/dev/null && [ "$(gunzip -c "$f" | wc -c | tr -d ' ')" = "$expect" ]; then
      log "  chunk $((part + 1))/$nparts of $name already on disk"
      i=$((i + count)); part=$((part + 1)); continue
    fi
    local try=0 ok=0 t0 t1 prc
    while [ $try -lt 5 ]; do
      wait_for_device || return 1
      t0=$(date +%s); prc=0
      pull_stream "$f.raw" "su -c 'dd if=$dev bs=$BS skip=$i count=$count 2>/dev/null'" || prc=$?
      t1=$(date +%s)
      if [ "$prc" = 0 ] && [ "$(wc -c < "$f.raw" | tr -d ' ')" = "$expect" ] && gzip -1 -c "$f.raw" > "$f"; then
        rm -f "$f.raw"; ok=1; break
      fi
      rm -f "$f.raw" "$f"
      try=$((try + 1))
      if [ "$prc" = 124 ]; then log "  chunk $((part + 1))/$nparts of $name stalled; resetting link (try $try)"; reset_transport
      else log "  chunk $((part + 1))/$nparts of $name came back short (try $try)"; fi
      sleep 3
    done
    [ $ok = 1 ] || { log "  !! giving up on $name after 5 tries"; rm -rf "$tmpd"; return 1; }
    [ $nparts -gt 1 ] && log "  chunk $((part + 1))/$nparts of $name ok ($(( expect / 1048576 )) MB in $(( t1 - t0 + 1 ))s)"
    i=$((i + count)); part=$((part + 1))
  done
  cat "$tmpd"/*.gz > "$out" && rm -rf "$tmpd"
}
if [ $ROOT = 1 ]; then
  mkdir -p "$OUT/partitions"
  touch "$OUT/partitions/SHA256SUMS.device"
  total=0
  while read -r name dev size; do
    [ -n "$name" ] && [ -n "$size" ] || continue
    case "$name" in mmcblk[0-9]|mmcblk[0-9][0-9]|sd[a-z]|sd[a-z][a-z]|nvme*n[0-9]) log "skipping $name (whole disk; its partitions are dumped individually)"; continue ;; esac
    if [ "$name" = userdata ] && [ $WANT_USERDATA = 0 ]; then log "skipping userdata (--no-userdata)"; continue; fi
    if grep -q " $name.img\$" "$OUT/partitions/SHA256SUMS.device" 2>/dev/null && [ -s "$OUT/partitions/$name.img.gz" ]; then
      log "$name already verified, skipping"; total=$((total + size)); continue
    fi
    log "dumping $name ($(human "$size")) from $dev"
    dump_partition "$name" "$dev" "$size" || continue
    wait_for_device || break
    # A partition mounted read-write keeps changing, so a hash taken after the
    # dump cannot match; its chunks were size-verified, record it as a live snapshot.
    if [ "$name" = userdata ] || grep -q "^$dev " "$OUT/info/mounts.txt" 2>/dev/null; then
      log "  ok (live filesystem, chunks size-verified; see partitions/README-live.txt), $(du -h "$OUT/partitions/$name.img.gz" | cut -f1) compressed"
      echo "live-snapshot  $name.img" >> "$OUT/partitions/SHA256SUMS.device"
      printf '%s was dumped while mounted and in use: each 256 MiB chunk is the exact size requested, but the image is a chunk-by-chunk snapshot, not an atomic one, so no device hash is recorded.\n' "$name.img.gz" >> "$OUT/partitions/README-live.txt"
      total=$((total + size)); continue
    fi
    dsum=$(su_ "sha256sum $dev" | tr -d '\r' | cut -d' ' -f1)
    lsum=$(gunzip -c "$OUT/partitions/$name.img.gz" | h256)
    if [ "$dsum" = "$lsum" ]; then
      log "  ok, $(du -h "$OUT/partitions/$name.img.gz" | cut -f1) compressed, sha256 $lsum"
      echo "$dsum  $name.img" >> "$OUT/partitions/SHA256SUMS.device"
      total=$((total + size))
    else
      log "  !! $name: sha256 mismatch device=$dsum local=$lsum (image kept as $name.img.gz.BAD)"
      mv "$OUT/partitions/$name.img.gz" "$OUT/partitions/$name.img.gz.BAD"
    fi
  done < "$OUT/info/partitions.txt"
  log "raw partitions: $(human "$total") of flash verified, $(du -sh "$OUT/partitions" | cut -f1) compressed"

  # ---------------------------------------------------------------- 6. /data archive (root)
  xflags=""
  if ash 'toybox tar --help 2>&1' | grep -q -- '--selinux'; then xflags="--selinux --xattrs"; fi
  log "archiving /data (app data, accounts, Magisk; excluding media and dalvik-cache; flags: ${xflags:-none})"
  for try in 1 2 3; do
    wait_for_device || break
    dprc=0
    pull_stream "$OUT/data.tar.gz" "su -c 'cd /data && toybox tar -cz $xflags --exclude=./media --exclude=./dalvik-cache --exclude=./cache -f - . 2>/dev/null'" || dprc=$?
    if [ "$dprc" = 0 ] && gzip -t "$OUT/data.tar.gz" 2>/dev/null; then
      log "  ok, $(du -sh "$OUT/data.tar.gz" | cut -f1), $(gunzip -c "$OUT/data.tar.gz" | tar -tf - 2>/dev/null | wc -l | tr -d ' ') entries"; break
    fi
    if [ "$dprc" = 124 ]; then log "  /data archive stalled; resetting link (try $try)"; reset_transport
    else log "  data.tar.gz came back truncated (try $try)"; fi
    sleep 3
  done
else
  # ---------------------------------------------------------------- fallback: adb backup
  log "adb backup -all -apk (confirm on the device; trying to tap it for you)"
  ( sleep 4; for _ in 1 2 3 4 5; do
      ash 'uiautomator dump /sdcard/.bk.xml >/dev/null 2>&1; cat /sdcard/.bk.xml' 2>/dev/null \
        | grep -oE 'text="[^"]*[Bb]ack up[^"]*"[^>]*bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' | head -1 \
        | grep -oE '\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]' | tr -d '[]' | tr ',' ' ' \
        | { read -r x1 y1 x2 y2 && ash input tap $(( (x1+x2)/2 )) $(( (y1+y2)/2 )) && break; } || sleep 2
    done; ash rm -f /sdcard/.bk.xml ) &
  a backup -all -apk -noshared -nosystem -f "$OUT/adb-backup.ab" >> "$LOG" 2>&1 || log "  adb backup failed or was not confirmed"
  wait
  [ -s "$OUT/adb-backup.ab" ] && log "  adb-backup.ab $(du -sh "$OUT/adb-backup.ab" | cut -f1)"
fi

# ---------------------------------------------------------------- 7. bugreport
if [ $WANT_BUGREPORT = 1 ]; then
  log "bugreport (this takes a few minutes)"
  a bugreport "$OUT/bugreport.zip" >> "$LOG" 2>&1 && log "  $(du -sh "$OUT/bugreport.zip" | cut -f1)" || log "  bugreport failed"
fi

# ---------------------------------------------------------------- done
( cd "$OUT" && find . -type f ! -name SHA256SUMS -print0 | xargs -0 shasum -a 256 2>/dev/null || find . -type f ! -name SHA256SUMS -print0 | xargs -0 sha256sum ) > "$OUT/SHA256SUMS" 2>/dev/null || true
log "done: $(du -sh "$OUT" | cut -f1) in $OUT"
