# android-editor settings (read by docker compose)

# ── Models ────────────────────────────────────────────────────────────────
# The two models every AI tool in the container uses (OpenCode, Cline, Roo Code).
# Pick your own with the catalog:   bin/pick-model list
# Discover new releases:            bin/pick-model refresh
# Verify tool calling + speed:      bin/pick-model check <#|name>
# Apply:                            bin/pick-model set default=<#|name> [reasoner=<#|name>]
# Update weights:                   bin/pick-model update
# The default MUST support tool calling — the agents run commands through it;
# the second model only feeds OpenCode's read-only @reasoner subagent.
#
# Size matters a lot. Models below ~20B params often fail to call tools
# reliably and go in loops / rabbit holes instead of making progress, so the
# workstation tier is the practical floor for agent work:
#   ~24 GB machine:  default qwen3.8:27b (18 GB), reasoner muse-glimmer:30b (18 GB)
#                    (one model is loaded at a time, so both fit in turn)
#   ~16 GB machine:  compact models (qwen3.5:9b, gpt-oss:20b) fit but are
#                    unreliable for agents — prefer a cloud or Anthropic backend
#                    (below) over fighting a too-small local model.
# If you can't run 24 GB+ locally, don't force it: point at a cloud or Claude
# backend instead. See docs/ai-backends.md.
OPENCODE_MODEL=ollama/qwen3.8:27b
OPENCODE_FALLBACK_MODEL=ollama/muse-glimmer:30b

# Ollama on the Mac, started by macos/host-services.sh (Metal-accelerated).
OLLAMA_URL=http://host.docker.internal:11436
# Context window the tools request. Cline and Roo Code need about 32k.
OLLAMA_NUM_CTX=32768

# Cline Plan mode and Roo architect/debug need tool calls, so they use the
# default model unless VSCODE_PLAN_MODEL names a (tool-capable) alternative.
VSCODE_PLAN_MODEL=
ROO_REASONER_MODES=

# 1 adds the Android NDK + CMake for apps with native code (~1.5 GB bigger).
INSTALL_NDK=0

# Container user ids; match your host user (id -u / id -g).
UID=1000
GID=1000

# ── Model backend: local | cloud | anthropic ──────────────────────────────
# local     = Ollama on this machine (the default).
# cloud     = any OpenAI-compatible endpoint: a hosted OSS API (Together,
#             DeepInfra, Fireworks — nothing to run, pay per token) or a GPU
#             instance you control (RunPod, Lambda, Vast.ai, self-hosted vLLM).
# anthropic = Claude — frontier reliability, no GPU to run or rent (see block
#             below). Local is the baseline; the others are opt-in for tasks
#             that need more compute than local runs well.
LLM_BACKEND=local

# Policy (bin/ai-backend): run locally while the local model fits the task.
# Escalate to the cloud/Anthropic model when (1) the task needs a bigger model
# than local runs well, or (2) the local model is STALLING — looping, retrying,
# or rabbit-holing without progress. On escalation a cloud instance is started
# on demand and stopped after the idle timeout so billing pauses. Escalating
# early on a stall is deliberate: a quick jump to bigger compute usually breaks
# the loop faster, and in less wall-clock time, than letting a small model grind.
LOCAL_MAX_B=20       # largest model size (B params) local is trusted to run well; above this -> escalate
ESCALATE_AFTER=2     # unproductive local attempts (loops / no progress) to tolerate before escalating; lower = bail from rabbit holes sooner
IDLE_MINUTES=15      # stop the cloud instance after this many idle minutes (billing pauses)
# AI_BACKEND_DRYRUN=1  # preview the local-vs-cloud decision (and why) without changing or running anything
CLOUD_PROVIDER=               # label shown in status output, e.g. runpod (free text)
CLOUD_LLM_URL=                # e.g. https://<instance>-8000.proxy.runpod.net/v1
CLOUD_LLM_KEY=                # token protecting the endpoint (not an account key)
CLOUD_LLM_MODEL=              # model the endpoint serves, e.g. qwen3-32b
# Optional instance lifecycle. Read by `bin/ai-backend start|stop|watch`, which
# uses them to start instances on demand and stop them when idle. Leave empty
# if you manage instances in your provider's console (backend switching still
# works). Commands are run with $CLOUD_INSTANCE_ID available.
CLOUD_INSTANCE_ID=
CLOUD_START_CMD=              # e.g. runpodctl pod start $CLOUD_INSTANCE_ID
CLOUD_STOP_CMD=               # e.g. runpodctl pod stop $CLOUD_INSTANCE_ID
CLOUD_STATUS_CMD=             # e.g. runpodctl pod get $CLOUD_INSTANCE_ID
CLOUD_SSH=                    # full ssh command for the instance (optional)
#
# RunPod worked example — burst GPU when a task needs a bigger model than the
# local machine runs well (any provider plugs in the same way):
#   CLOUD_PROVIDER=runpod
#   CLOUD_LLM_URL=https://<podid>-8000.proxy.runpod.net/v1
#   CLOUD_LLM_KEY=
#   CLOUD_LLM_MODEL=qwen3-32b
#   CLOUD_INSTANCE_ID=<podid>
#   CLOUD_START_CMD='runpodctl pod start $CLOUD_INSTANCE_ID'
#   CLOUD_STOP_CMD='runpodctl pod stop $CLOUD_INSTANCE_ID'
#   CLOUD_STATUS_CMD='runpodctl pod get $CLOUD_INSTANCE_ID'
#   CLOUD_SSH='<podid>-<port>@ssh.runpod.io'
#   RUNPOD_API_KEY=           # runpodctl account key; keep it out of git
#
# Easiest cloud path — a hosted OpenAI-compatible OSS API (nothing to start or
# stop, pay per token). Set LLM_BACKEND=cloud and leave the CLOUD_*_CMD empty:
#   Together AI:  CLOUD_LLM_URL=https://api.together.xyz/v1
#                 CLOUD_LLM_MODEL=Qwen/Qwen3-235B-A22B-fp8-tput    CLOUD_LLM_KEY=<key>
#   DeepInfra:    CLOUD_LLM_URL=https://api.deepinfra.com/v1/openai
#                 CLOUD_LLM_MODEL=Qwen/Qwen3-32B                   CLOUD_LLM_KEY=<key>
#   Fireworks:    CLOUD_LLM_URL=https://api.fireworks.ai/inference/v1
#                 CLOUD_LLM_MODEL=accounts/fireworks/models/qwen3-30b-a3b  CLOUD_LLM_KEY=<key>
#
# ── Anthropic / Claude backend (optional) ─────────────────────────────────
# LLM_BACKEND=anthropic points Cline, Roo Code and OpenCode at Claude instead
# of an OSS model — frontier reliability (it always calls tools), no GPU to run
# or rent. Billed per token by Anthropic. Keep the key out of git.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5     # a current Claude model id
#
# Legacy names are still read when the CLOUD_* equivalents are empty:
# RUNPOD_LLM_URL, RUNPOD_LLM_KEY, RUNPOD_LLM_MODEL, RUNPOD_POD_ID, RUNPOD_SSH,
# and LLM_BACKEND=runpod is treated as LLM_BACKEND=cloud.
