# android-editor settings (read by docker compose)

# The two models every AI tool in the container uses (OpenCode, Cline, Roo Code).
OPENCODE_MODEL=ollama/qwen3:14b
OPENCODE_FALLBACK_MODEL=ollama/deepseek-r1:14b-qwen-distill-q8_0

# Ollama on the Mac, started by macos/host-services.sh (Metal-accelerated).
OLLAMA_URL=http://host.docker.internal:11436
# Context window the tools request. Cline and Roo Code need about 32k.
OLLAMA_NUM_CTX=32768

# Cline Plan mode and Roo architect/debug need tool calls, so they use the
# default model unless VSCODE_PLAN_MODEL names a (tool-capable) alternative.
VSCODE_PLAN_MODEL=
ROO_REASONER_MODES=

# 1 adds the Android NDK + CMake for apps with native code (~1.5 GB bigger).
INSTALL_NDK=0

# Container user ids; match your host user (id -u / id -g).
UID=1000
GID=1000

# ── Remote model backend (optional, RunPod vLLM pod) ─────────────────────
# LLM_BACKEND=local uses the Mac's Ollama; =runpod uses the GPU pod below.
# RUNPOD_API_KEY is your RunPod *account* key (runpodctl); RUNPOD_LLM_KEY is
# the token that protects the pod's vLLM endpoint. Keep both out of git.
LLM_BACKEND=local
RUNPOD_LLM_URL=https://<podid>-8000.proxy.runpod.net/v1
RUNPOD_LLM_KEY=
RUNPOD_LLM_MODEL=qwen3-32b
RUNPOD_POD_ID=
RUNPOD_API_KEY=
# ssh <podid>-<port>@ssh.runpod.io
RUNPOD_SSH=
