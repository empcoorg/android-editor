#!/bin/bash
# pick-model: choose the models the AI tools use (OpenCode, Cline, Roo Code).
#
#   pick-model list                 curated current models by machine size, with
#                                   install status and the picks in .env
#   pick-model check [model]        tool-calling smoke test + speed against the
#                                   local Ollama (default: the .env default model)
#   pick-model set default=<m> [reasoner=<m>] [--no-check]
#                                   write OPENCODE_MODEL / OPENCODE_FALLBACK_MODEL;
#                                   the default is verified for tool calling first
#   pick-model set cloud=<m>        write CLOUD_LLM_MODEL (the cloud endpoint's model)
#
# <m> is a catalog number from `list` or any model name (ollama/... is added
# for local picks). HOST-side: reads .env, talks to Ollama over HTTP.
#
# The default model MUST support tool calling — the agents run commands
# through it. `check` proves it on your machine and reports tok/s.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"; cd "$ROOT" || exit 1
ENVF="${ANDROID_EDITOR_ENV:-$ROOT/.env}"

envv() {
  local v; v=$(grep -m1 "^$1=" "$ENVF" 2>/dev/null | cut -d= -f2-)
  case "$v" in
    \'*\') v="${v#\'}"; v="${v%\'}" ;;
    \"*\') v="${v#\"}"; v="${v%\"}" ;;
  esac
  printf '%s' "$v"
}
set_env() { # key value
  if grep -q "^$1=" "$ENVF" 2>/dev/null; then sed -i.bak "s|^$1=.*|$1=$2|" "$ENVF" && rm -f "$ENVF.bak"
  else echo "$1=$2" >> "$ENVF"; fi
}
OLLAMA="$(envv OLLAMA_URL)"; OLLAMA="${OLLAMA:-http://127.0.0.1:11436}"
OLLAMA="${OLLAMA/host.docker.internal/127.0.0.1}"

# Catalog: tier | model | download GB | note. Checked against the Ollama
# library; refresh when newer models land (list shows what is installed).
CATALOG=$(cat <<'EOF'
compact	gemma4:e2b	6	tiny on-device helper; tools, vision, 128K ctx
compact	gemma4:e4b	8	lightweight default for 8-16 GB machines; tools, vision
compact	qwen3.5:9b	7	small current-gen default; tools, vision, 256K ctx
compact	gpt-oss:20b	12	reasoning + tools; tight on 16 GB, fine on 24 GB
workstation	qwen3.8:27b	18	current top local pick for coding agents; tools, vision, thinking
workstation	qwen3.5:27b	18	Qwen3.5 flagship 27B; tools, vision, 256K ctx
workstation	muse-glimmer:30b	18	Meta agent model tuned for tools + failure recovery
workstation	gemma4:26b	17	Google MoE, 3.8B active; tools, vision, 256K ctx
workstation	qwen3-coder:30b	19	coding-focused MoE, 3.3B active; tools, 256K ctx
workstation	nemotron-3.5-lightning:30b	25	NVIDIA always-on agent model, 3B active
workstation	qwen3.5:35b	22	Qwen3.5 35B; tools, vision
big	qwen3.5:122b	81	Qwen3.5 large; needs 64 GB+ memory
big	gemma4:31b	20	Gemma 4 dense flagship; tools, vision, audio
EOF
)

installed_models() { curl -fsS -m 5 "$OLLAMA/api/tags" 2>/dev/null | jq -r '.models[].name' ; }

catalog_line() { printf '%s\n' "$CATALOG" | awk -F'\t' -v n="$1" 'NR==n'; }
resolve() { # model-or-number -> bare model name
  local x="$1"
  if printf '%s' "$x" | grep -qE '^[0-9]+$'; then
    x=$(catalog_line "$x" | cut -f2)
    [ -n "$x" ] || { echo "pick-model: no catalog entry #$1" >&2; return 1; }
  fi
  x="${x#ollama/}"
  printf '%s' "$x"
}
cmd_list() {
  local have cur_default cur_reasoner i=0 tier m gb note mark status cloud
  have=$(installed_models)
  cur_default="$(envv OPENCODE_MODEL)"; cur_default="${cur_default#ollama/}"
  cur_reasoner="$(envv OPENCODE_FALLBACK_MODEL)"; cur_reasoner="${cur_reasoner#ollama/}"
  cloud="$(envv CLOUD_LLM_MODEL)"; cloud="${cloud:-$(envv RUNPOD_LLM_MODEL)}"
  echo "Models in .env:  default=${cur_default:-<unset>}  reasoner=${cur_reasoner:-<unset>}  cloud=${cloud:-<unset>}"
  echo "Ollama:          $OLLAMA $(curl -fsS -m 5 "$OLLAMA/api/version" 2>/dev/null | jq -r '"(v" + .version + ")"' || echo '(not reachable)')"
  echo
  printf '%-3s %-12s %-27s %-8s %-10s %s\n' '#' TIER MODEL SIZE STATUS NOTE
  while IFS=$'\t' read -r tier m gb note; do
    i=$((i+1))
    mark=""; [ "$m" = "$cur_default" ] && mark="$mark*"; [ "$m" = "$cur_reasoner" ] && mark="$mark+"
    if grep -qx "$m" <<<"$have" || grep -qx "$m:latest" <<<"$have"; then status="installed"; else status="-"; fi
    printf '%-3s %-12s %-27s %-8s %-10s %s\n' "$i" "$tier" "$m" "${gb}GB" "$status$mark" "$note"
  done <<<"$CATALOG"
  echo
  echo "* = agent default in .env   + = @reasoner in .env"
  echo "Pick with:  bin/pick-model set default=<#|name> [reasoner=<#|name>]"
  echo "Verify:     bin/pick-model check <#|name>   (tool calling + speed)"
}

cmd_check() {
  local m resp err tools tok_s load_s
  m=$(resolve "${1:-$(envv OPENCODE_MODEL)}") || exit 2
  m="${m#ollama/}"
  echo "model    $m  ($OLLAMA)"
  resp=$(curl -sS -m 180 "$OLLAMA/api/chat" -d "$(jq -cn --arg m "$m" '{
    model: $m, stream: false, options: { num_ctx: 8192 },
    messages: [ { role: "user", content: "Call the list_files tool with path=/tmp. Do not reply in text." } ],
    tools: [ { type: "function", function: { name: "list_files", description: "List files in a directory",
      parameters: { type: "object", properties: { path: { type: "string", description: "directory to list" } }, required: ["path"] } } } ]
  }')" 2>/dev/null)
  err=$(jq -r '.error // empty' <<<"$resp" 2>/dev/null)
  if [ -n "$err" ] || [ -z "$resp" ]; then
    echo "error    ${err:-no response from Ollama}"
    echo "verdict  cannot test — is the model pulled? (make models / ollama pull $m)"
    return 2
  fi
  tools=$(jq '.message.tool_calls // [] | length' <<<"$resp")
  tok_s=$(jq -r 'if (.eval_duration // 0) > 0 then (((.eval_count // 0) / (.eval_duration / 1e9)) * 10 | round / 10 | tostring) else "n/a" end' <<<"$resp")
  load_s=$(jq -r 'if (.load_duration // 0) > 0 then ((.load_duration / 1e9 * 10 | round / 10) | tostring) else "n/a" end' <<<"$resp")
  echo "speed    ${tok_s} tok/s   (model load ${load_s}s)"
  if [ "$tools" -gt 0 ]; then
    echo "tools    yes -> $(jq -c '.message.tool_calls[0].function.arguments // {}' <<<"$resp")"
    echo "verdict  OK — tool-capable: safe as the agent default"
    return 0
  fi
  echo "tools    no (plain text reply, no function call)"
  echo "verdict  NOT tool-capable — do not use as the agent default (fine as the read-only @reasoner)"
  return 1
}


cmd_set() {
  local check=1 default="" reasoner="" cloud="" kv rc
  for kv in "$@"; do
    case "$kv" in
      --no-check) check=0 ;;
      default=*)  default="${kv#default=}" ;;
      reasoner=*) reasoner="${kv#reasoner=}" ;;
      cloud=*)    cloud="${kv#cloud=}" ;;
      *) echo "pick-model set: unknown argument: $kv" >&2; exit 2 ;;
    esac
  done
  if [ -z "$default$reasoner$cloud" ]; then
    echo "usage: bin/pick-model set default=<#|name> [reasoner=<#|name>] [cloud=<model>] [--no-check]" >&2; exit 2
  fi
  [ -f "$ENVF" ] || { echo "pick-model: $ENVF not found — copy .env.example to .env first" >&2; exit 2; }
  if [ -n "$default" ]; then
    default=$(resolve "$default") || exit 2
    if [ "$check" = 1 ]; then
      echo "verifying tool calling on the default model before writing .env ..."
      cmd_check "$default"; rc=$?
      [ "$rc" = 2 ] && exit 2
      [ "$rc" = 1 ] && { echo "refusing: $default cannot call tools (re-run with --no-check to force)" >&2; exit 1; }
    fi
    set_env OPENCODE_MODEL "ollama/$default"
    echo "OPENCODE_MODEL=ollama/$default"
  fi
  if [ -n "$reasoner" ]; then
    reasoner=$(resolve "$reasoner") || exit 2
    set_env OPENCODE_FALLBACK_MODEL "ollama/$reasoner"
    echo "OPENCODE_FALLBACK_MODEL=ollama/$reasoner"
  fi
  if [ -n "$cloud" ]; then
    set_env CLOUD_LLM_MODEL "$cloud"
    echo "CLOUD_LLM_MODEL=$cloud"
  fi
  echo
  echo "next: make models          # pull anything missing"
  echo "      recreate the dev container (make dev-up, or Dev Containers: Reload Window) to regenerate the tool configs"
}

case "${1:-list}" in
  list)    shift; cmd_list "$@" ;;
  check)   shift; cmd_check "$@" ;;
  set)     shift; cmd_set "$@" ;;
  -h|--help|help) sed -n '2,17p' "$0" ;;
  *) echo "unknown: $1 (see --help)" >&2; exit 2 ;;
esac

