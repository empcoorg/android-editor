#!/bin/bash
# ai-backend: capability-aware choice between local Ollama, a cloud endpoint
# (any OpenAI-compatible provider), and Claude (LLM_BACKEND=anthropic); start
# the remote instance on demand, stop it after a fixed idle timeout.
#
# HOST-side tool (needs docker, curl, jq; provider CLI such as runpodctl is
# only needed for the built-in RunPod fallback — any other provider supplies
# CLOUD_START_CMD / CLOUD_STOP_CMD / CLOUD_STATUS_CMD in .env). The
# container's AI config is regenerated by recreating the dev service, exactly
# like `make cloud-up` / `cloud-down` do.
#
#   ai-backend status                 backend, models, instance state, idle timer
#   ai-backend start                  switch to cloud; start the instance if a
#                                      lifecycle command is configured
#   ai-backend pick <default|large>   choose backend+model; start instance if needed
#   ai-backend escalate               jump to the bigger backend now (cloud, or
#                                      Claude if ANTHROPIC_API_KEY is set)
#   ai-backend stall                  report a stalled local attempt; auto-escalates
#                                      once ESCALATE_AFTER stalls pile up
#   ai-backend beat                   record activity (resets the idle timer)
#   ai-backend watch [--once]         stop the instance once idle > IDLE_MINUTES
#   ai-backend stop                   back to local; stop the instance (billing pauses)
#   ai-backend recommend "<task>"     suggest which AI tool fits the task
#
# Env:  IDLE_MINUTES   (15)  idle time before the instance is auto-stopped
#       LOCAL_MAX_B    (20)  params (B) local Ollama is trusted to run well
#       ESCALATE_AFTER (2)   stalled local attempts before auto-escalating to cloud/Claude
#       AI_BACKEND_DRYRUN=1  print the decision without starting/stopping anything
#
# Policy: run locally while the local model fits the task. Escalate to the
# cloud/Anthropic model when (1) a task needs a bigger model than local runs
# well, or (2) local is STALLING — looping or retrying without progress. On
# escalation a cloud instance is started on demand and stopped after the idle
# timeout so billing pauses. Escalating early on a stall is deliberate: a quick
# jump to bigger compute usually breaks the loop faster, and in less wall-clock
# time, than letting a small model grind. A caller (agent wrapper, or you)
# signals a stall with `ai-backend stall`; `ai-backend escalate` jumps at once.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"; cd "$ROOT" || exit 1
ENVF="$ROOT/.env"; STATE="${HOME}/.android-editor"; mkdir -p "$STATE"
BEAT="$STATE/ai-backend.last"; PODSTART="$STATE/ai-backend.pod-started"; STALLS="$STATE/ai-backend.stalls"
IDLE_MINUTES="${IDLE_MINUTES:-15}"; LOCAL_MAX_B="${LOCAL_MAX_B:-20}"; ESCALATE_AFTER="${ESCALATE_AFTER:-2}"; DRYRUN="${AI_BACKEND_DRYRUN:-0}"

envv() {
  local v; v=$(grep -m1 "^$1=" "$ENVF" 2>/dev/null | cut -d= -f2-)
  # Strip surrounding quotes, the way docker compose parses .env values.
  case "$v" in
    \'*\') v="${v#\'}"; v="${v%\'}" ;;
    \"*\") v="${v#\"}"; v="${v%\"}" ;;
  esac
  printf '%s' "$v"
}
# Backend + cloud endpoint; legacy RUNPOD_* / LLM_BACKEND=runpod still work.
BACKEND="$(envv LLM_BACKEND)"; BACKEND="${BACKEND:-local}"; [ "$BACKEND" = runpod ] && BACKEND=cloud
CLOUD_URL="$(envv CLOUD_LLM_URL)";     [ -n "$CLOUD_URL" ]   || CLOUD_URL="$(envv RUNPOD_LLM_URL)"
CLOUD_KEY="$(envv CLOUD_LLM_KEY)";     [ -n "$CLOUD_KEY" ]   || CLOUD_KEY="$(envv RUNPOD_LLM_KEY)"
CLOUD_MODEL="$(envv CLOUD_LLM_MODEL)"; [ -n "$CLOUD_MODEL" ] || CLOUD_MODEL="$(envv RUNPOD_LLM_MODEL)"
INSTANCE="$(envv CLOUD_INSTANCE_ID)";  [ -n "$INSTANCE" ]    || INSTANCE="$(envv RUNPOD_POD_ID)"
PROVIDER="$(envv CLOUD_PROVIDER)"
if [ -z "$PROVIDER" ]; then
  if [ -n "$(envv RUNPOD_LLM_URL)" ] || [ -n "$(envv RUNPOD_POD_ID)" ]; then PROVIDER=runpod; else PROVIDER=cloud; fi
fi
START_CMD="$(envv CLOUD_START_CMD)"; STOP_CMD="$(envv CLOUD_STOP_CMD)"; STATUS_CMD="$(envv CLOUD_STATUS_CMD)"
export CLOUD_INSTANCE_ID="$INSTANCE"
LOCAL_MODEL="$(envv OPENCODE_MODEL)"; LOCAL_MODEL="${LOCAL_MODEL#ollama/}"
OLLAMA_URL="$(envv OLLAMA_URL)"; OLLAMA_URL="${OLLAMA_URL:-http://127.0.0.1:11436}"
# This tool runs on the HOST, where the container-only name does not resolve;
# point local checks at loopback (Ollama binds there via host-services.sh).
OLLAMA_HOST_URL="${OLLAMA_URL/host.docker.internal/127.0.0.1}"

compose_files() {
  if [ "$(uname -s)" = Darwin ]; then echo "-f docker-compose.yml -f docker-compose.mac-usb.yml"
  else echo "-f docker-compose.yml -f docker-compose.linux-usb.yml"; fi
}
recreate_dev() { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) docker compose up -d dev"; return; }; docker compose $(compose_files) up -d dev >/dev/null 2>&1; }
model_b() { printf '%s' "$1" | grep -oiE '[0-9]+(\.[0-9]+)?b' | head -1 | tr -d 'bB'; }
fmt_model() { local m="$1" b; b=$(model_b "$m"); printf '%s%s' "$m" "${b:+ (${b}B)}"; }

ollama_up() { curl -fsS -m 5 "$OLLAMA_HOST_URL/api/version" >/dev/null 2>&1; }
ollama_has() { curl -fsS -m 5 "$OLLAMA_HOST_URL/api/tags" 2>/dev/null | jq -e --arg m "$1" '.models[]|select(.name==$m or .name==($m+":latest"))' >/dev/null 2>&1; }

# Instance lifecycle: CLOUD_*_CMD hooks from .env first; if none are set and
# the provider is runpod with runpodctl installed, the pod id works directly.
have_runpod_fallback() { [ "$PROVIDER" = runpod ] && [ -n "$INSTANCE" ] && command -v runpodctl >/dev/null 2>&1; }
instance_state() {
  if [ -n "$STATUS_CMD" ]; then local out; out=$(eval "$STATUS_CMD" 2>/dev/null | head -1); echo "${out:-unknown}"
  elif have_runpod_fallback; then runpodctl pod get "$INSTANCE" 2>/dev/null | jq -r '.runtimeStatus // "unknown"'
  else echo manual; fi
}
instance_start() {
  if [ -n "$START_CMD" ]; then
    [ "$DRYRUN" = 1 ] && { echo "  (dry-run) $START_CMD"; return; }
    eval "$START_CMD"
  elif have_runpod_fallback; then
    [ "$DRYRUN" = 1 ] && { echo "  (dry-run) runpodctl pod start $INSTANCE"; return; }
    runpodctl pod start "$INSTANCE"
  else
    echo "  no CLOUD_START_CMD configured; start the instance in your provider's console"
    return 0
  fi
  date +%s > "$PODSTART"
}
instance_stop() {
  if [ -n "$STOP_CMD" ]; then
    [ "$DRYRUN" = 1 ] && { echo "  (dry-run) $STOP_CMD"; return; }
    eval "$STOP_CMD"; rm -f "$PODSTART"
  elif have_runpod_fallback; then
    [ "$DRYRUN" = 1 ] && { echo "  (dry-run) runpodctl pod stop $INSTANCE"; return; }
    runpodctl pod stop "$INSTANCE"; rm -f "$PODSTART"
  else
    echo "  no CLOUD_STOP_CMD configured; stop the instance in your provider's console"
  fi
}

set_backend() {
  local b="$1"
  [ "$DRYRUN" = 1 ] && { echo "  (dry-run) set LLM_BACKEND=$b"; return; }
  if ! grep -q '^LLM_BACKEND=' "$ENVF" 2>/dev/null; then echo "LLM_BACKEND=$b" >> "$ENVF"
  else sed -i.bak "s/^LLM_BACKEND=.*/LLM_BACKEND=$b/" "$ENVF" && rm -f "$ENVF.bak"; fi
  [ "$b" = local ] && rm -f "$STALLS"
  recreate_dev
}

now() { date +%s; }
beat() { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) beat"; return; }; now > "$BEAT"; }
idle_ref() {
  local b=0 p=0 m
  [ -f "$BEAT" ] && b=$(cat "$BEAT" 2>/dev/null); [ -f "$PODSTART" ] && p=$(cat "$PODSTART" 2>/dev/null)
  b=${b:-0}; p=${p:-0}; m=$(( b>p ? b : p )); [ "$m" -eq 0 ] && m=$(now); echo "$m"
}
idle_seconds() { echo $(( $(now) - $(idle_ref) )); }

recommend_tool() {
  local t; t=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
  case "$t" in
    *flash*|*root*|*boot*|*fastboot*|*partition*|*magisk*|*backup*|*adb\ *) echo "OpenCode (autonomous terminal agent; runs adb/fastboot/flash steps)" ;;
    *plan*|*architect*|*design*|*debug*|*mode*) echo "Roo Code (mode-specialized: architect/debug/orchestrator)" ;;
    *refactor*|*feature*|*test*|*review*|*implement*|*edit*) echo "Cline (interactive VS Code coding, Act/Plan modes)" ;;
    "") echo "Cline for interactive work; OpenCode for autonomous multi-step terminal tasks" ;;
    *) echo "Cline (general interactive coding)" ;;
  esac
}

cmd_status() {
  local st; st=$(instance_state)
  echo "AI backend"
  echo "  LLM_BACKEND     $(envv LLM_BACKEND)  (normalized: $BACKEND)"
  echo "  provider        $PROVIDER"
  echo "  cloud model     $(fmt_model "$CLOUD_MODEL")"
  echo "  endpoint        ${CLOUD_URL:-<not set>}"
  [ "$BACKEND" = anthropic ] && echo "  anthropic model $(envv ANTHROPIC_MODEL)  ($([ -n "$(envv ANTHROPIC_API_KEY)" ] && echo 'key set' || echo 'NO KEY'))"
  echo "  local model     $(fmt_model "$LOCAL_MODEL")$(ollama_has "$LOCAL_MODEL" && echo '  [present]' || echo '  [MISSING in Ollama]')"
  echo "  instance        ${INSTANCE:-<none>}  $st"
  [ "$st" = running ] && echo "  idle            $(idle_seconds)s / $((IDLE_MINUTES*60))s before auto-stop"
  return 0
}

cmd_start() {
  if [ -z "$CLOUD_URL" ] || [ -z "$CLOUD_MODEL" ]; then
    echo "start: CLOUD_LLM_URL/CLOUD_LLM_MODEL are not set in .env — add them first (see .env.example)" >&2; exit 2
  fi
  echo "start: $PROVIDER endpoint, cloud model $(fmt_model "$CLOUD_MODEL")"
  if [ "$(instance_state)" != running ]; then echo "  instance not running; starting..."; instance_start
  else echo "  instance already running"; fi
  set_backend cloud; beat
  echo "  LLM_BACKEND=cloud. Endpoint warms up in a few minutes (ai-backend status)."
}

cmd_pick() {
  local tier="${1:-default}" lb pb st
  lb=$(model_b "$LOCAL_MODEL"); pb=$(model_b "$CLOUD_MODEL"); lb=${lb:-0}; pb=${pb:-0}
  if [ "$tier" = large ] && [ -n "$CLOUD_URL" ] && [ "$pb" -gt "$lb" ] && [ "$lb" -le "$LOCAL_MAX_B" ]; then
    echo "pick: large task -> cloud $(fmt_model "$CLOUD_MODEL") ($PROVIDER); local tops out at $(fmt_model "$LOCAL_MODEL")"
    st=$(instance_state)
    if [ "$st" != running ]; then echo "  instance not running; starting on demand..."; instance_start; fi
    set_backend cloud; beat
    echo "  LLM_BACKEND=cloud. Endpoint warms up in a few minutes (ai-backend status)."
  else
    [ "$tier" = large ] && [ -z "$CLOUD_URL" ] && echo "  note: the large tier needs CLOUD_LLM_URL/CLOUD_LLM_MODEL in .env; using local"
    echo "pick: $tier task -> local $(fmt_model "$LOCAL_MODEL")"
    ollama_has "$LOCAL_MODEL" || echo "  note: local model missing; run 'make models' to pull it"
    set_backend local; beat
    echo "  LLM_BACKEND=local."
  fi
}

# The bigger backend to jump to on a stall: Claude if configured, else cloud.
escalate_target() {
  if [ -n "$(envv ANTHROPIC_API_KEY)" ]; then echo anthropic
  elif [ -n "$CLOUD_URL" ] && [ -n "$CLOUD_MODEL" ]; then echo cloud
  else echo ""; fi
}
cmd_escalate() {
  local tgt; tgt=$(escalate_target)
  [ -n "$tgt" ] || { echo "escalate: no bigger backend configured — set ANTHROPIC_API_KEY, or CLOUD_LLM_URL/CLOUD_LLM_MODEL, in .env (see .env.example)" >&2; exit 2; }
  if [ "$tgt" = cloud ]; then
    echo "escalate -> cloud $(fmt_model "$CLOUD_MODEL") ($PROVIDER)"
    if [ "$(instance_state)" != running ]; then echo "  instance not running; starting on demand..."; instance_start; fi
    set_backend cloud
    echo "  LLM_BACKEND=cloud. Endpoint warms up in a few minutes (ai-backend status)."
  else
    echo "escalate -> Claude ($(envv ANTHROPIC_MODEL))"
    set_backend anthropic
    echo "  LLM_BACKEND=anthropic. Reached directly, nothing to start/stop."
  fi
  rm -f "$STALLS"; beat
}
cmd_stall() {
  if [ "$BACKEND" != local ]; then echo "stall: already on $BACKEND (not local); nothing to escalate"; return 0; fi
  local n; n=$(( $(cat "$STALLS" 2>/dev/null || echo 0) + 1 ))
  if [ "$n" -ge "$ESCALATE_AFTER" ]; then
    echo "stall $n/$ESCALATE_AFTER on local -> escalating"
    cmd_escalate
  else
    [ "$DRYRUN" = 1 ] || echo "$n" > "$STALLS"
    echo "stall $n/$ESCALATE_AFTER on local (escalates at $ESCALATE_AFTER; run 'ai-backend escalate' to jump now)"
  fi
}

cmd_watch() {
  local once=0; [ "${1:-}" = --once ] && once=1
  if [ -z "$STOP_CMD" ] && ! have_runpod_fallback; then
    echo "watch: no CLOUD_STOP_CMD configured and no runpodctl fallback — set CLOUD_STOP_CMD in .env or manage the instance in your provider's console"
    return 0
  fi
  echo "watching: cloud instance auto-stops after ${IDLE_MINUTES}m idle (ctrl-c to quit)"
  while true; do
    if [ "$(instance_state)" = running ] && [ "$(idle_seconds)" -gt $((IDLE_MINUTES*60)) ]; then
      echo "$(date '+%H:%M:%S') idle > ${IDLE_MINUTES}m -> stopping instance, backend -> local"
      instance_stop; set_backend local
    fi
    [ "$once" = 1 ] && break
    sleep 60
  done
}

case "${1:-status}" in
  status)     shift; cmd_status "$@" ;;
  start)      shift; cmd_start "$@" ;;
  pick)       shift; cmd_pick "$@" ;;
  escalate)   shift; cmd_escalate "$@" ;;
  stall)      shift; cmd_stall "$@" ;;
  beat)       beat ;;
  watch)      shift; cmd_watch "$@" ;;
  stop)       instance_stop; set_backend local; echo "backend -> local; instance stopped where a stop command is configured" ;;
  recommend)  shift; echo "task: ${1:-<none>}"; echo "suggest: $(recommend_tool "${1:-}")" ;;
  -h|--help|help) sed -n '2,37p' "$0" ;;
  *) echo "unknown: $1 (see --help)" >&2; exit 2 ;;
esac

