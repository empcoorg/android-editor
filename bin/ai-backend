#!/bin/bash
# ai-backend: capability-aware choice between local Ollama and the RunPod GPU
# pod — start the pod on demand, stop it after a fixed idle timeout.
#
# HOST-side tool (needs runpodctl, docker, curl, jq on the machine running the
# containers). The container's AI config is regenerated by recreating the dev
# service, exactly like `make runpod-up` / `runpod-down` do.
#
#   ai-backend status                 backend, models, pod state, idle timer
#   ai-backend pick <default|large>   choose backend+model; start pod if needed
#   ai-backend beat                   record activity (resets the idle timer)
#   ai-backend watch [--once]         stop the pod once idle > IDLE_MINUTES
#   ai-backend stop                   stop the pod now (billing pauses)
#   ai-backend recommend "<task>"     suggest which AI tool fits the task
#
# Env:  IDLE_MINUTES (15)   idle time before the pod is auto-stopped
#       LOCAL_MAX_B  (20)   params (B) local Ollama is trusted to run well
#       AI_BACKEND_DRYRUN=1 print the decision without starting/stopping anything
#
# Policy: use local when it fits the requested tier; when a tier needs a bigger
# model than local can run well and the pod offers one, start the pod on demand.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"; cd "$ROOT" || exit 1
ENVF="$ROOT/.env"; STATE="${HOME}/.android-editor"; mkdir -p "$STATE"
BEAT="$STATE/ai-backend.last"; PODSTART="$STATE/ai-backend.pod-started"
IDLE_MINUTES="${IDLE_MINUTES:-15}"; LOCAL_MAX_B="${LOCAL_MAX_B:-20}"; DRYRUN="${AI_BACKEND_DRYRUN:-0}"

envv() { grep -m1 "^$1=" "$ENVF" 2>/dev/null | cut -d= -f2-; }
POD="$(envv RUNPOD_POD_ID)"
LOCAL_MODEL="$(envv OPENCODE_MODEL)"; LOCAL_MODEL="${LOCAL_MODEL#ollama/}"
POD_MODEL="$(envv RUNPOD_LLM_MODEL)"
OLLAMA_URL="$(envv OLLAMA_URL)"; OLLAMA_URL="${OLLAMA_URL:-http://127.0.0.1:11436}"
# This tool runs on the HOST, where the container-only name does not resolve;
# point local checks at loopback (Ollama binds there via host-services.sh).
OLLAMA_HOST_URL="${OLLAMA_URL/host.docker.internal/127.0.0.1}"

compose_files() {
  if [ "$(uname -s)" = Darwin ]; then echo "-f docker-compose.yml -f docker-compose.mac-usb.yml"
  else echo "-f docker-compose.yml -f docker-compose.linux-usb.yml"; fi
}
recreate_dev() { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) docker compose up -d dev"; return; }; docker compose $(compose_files) up -d dev >/dev/null 2>&1; }
model_b() { printf '%s' "$1" | grep -oiE '[0-9]+(\.[0-9]+)?b' | head -1 | tr -d 'bB'; }
fmt_model() { local m="$1" b; b=$(model_b "$m"); printf '%s%s' "$m" "${b:+ (${b}B)}"; }

ollama_up() { curl -fsS -m 5 "$OLLAMA_HOST_URL/api/version" >/dev/null 2>&1; }
ollama_has() { curl -fsS -m 5 "$OLLAMA_HOST_URL/api/tags" 2>/dev/null | jq -e --arg m "$1" '.models[]|select(.name==$m or .name==($m+":latest"))' >/dev/null 2>&1; }

pod_state() { [ -n "$POD" ] || { echo unknown; return; }; runpodctl pod get "$POD" 2>/dev/null | jq -r '.runtimeStatus // "unknown"'; }
pod_start() { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) runpodctl pod start $POD"; return; }; runpodctl pod start "$POD" >/dev/null 2>&1; date +%s > "$PODSTART"; }
pod_stop()  { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) runpodctl pod stop $POD"; return; }; runpodctl pod stop "$POD" >/dev/null 2>&1; rm -f "$PODSTART"; }

set_backend() {
  local b="$1"
  [ "$DRYRUN" = 1 ] && { echo "  (dry-run) set LLM_BACKEND=$b"; return; }
  sed -i.bak "s/^LLM_BACKEND=.*/LLM_BACKEND=$b/" "$ENVF" && rm -f "$ENVF.bak"
  recreate_dev
}

now() { date +%s; }
beat() { [ "$DRYRUN" = 1 ] && { echo "  (dry-run) beat"; return; }; now > "$BEAT"; }
idle_ref() {
  local b=0 p=0 m
  [ -f "$BEAT" ] && b=$(cat "$BEAT" 2>/dev/null); [ -f "$PODSTART" ] && p=$(cat "$PODSTART" 2>/dev/null)
  b=${b:-0}; p=${p:-0}; m=$(( b>p ? b : p )); [ "$m" -eq 0 ] && m=$(now); echo "$m"
}
idle_seconds() { echo $(( $(now) - $(idle_ref) )); }

recommend_tool() {
  local t; t=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
  case "$t" in
    *flash*|*root*|*boot*|*fastboot*|*partition*|*magisk*|*backup*|*adb\ *) echo "OpenCode (autonomous terminal agent; runs adb/fastboot/flash steps)" ;;
    *plan*|*architect*|*design*|*debug*|*mode*) echo "Roo Code (mode-specialized: architect/debug/orchestrator)" ;;
    *refactor*|*feature*|*test*|*review*|*implement*|*edit*) echo "Cline (interactive VS Code coding, Act/Plan modes)" ;;
    "") echo "Cline for interactive work; OpenCode for autonomous multi-step terminal tasks" ;;
    *) echo "Cline (general interactive coding)" ;;
  esac
}

cmd_status() {
  local st; st=$(pod_state)
  echo "AI backend"; echo "  LLM_BACKEND     $(envv LLM_BACKEND)"
  echo "  local model     $(fmt_model "$LOCAL_MODEL")$(ollama_has "$LOCAL_MODEL" && echo '  [present]' || echo '  [MISSING in Ollama]')"
  echo "  pod model       $(fmt_model "$POD_MODEL")"
  echo "  pod ($POD)      $st"
  [ "$st" = running ] && echo "  idle            $(idle_seconds)s / $((IDLE_MINUTES*60))s before auto-stop"
  return 0
}

cmd_pick() {
  local tier="${1:-default}" lb pb st
  lb=$(model_b "$LOCAL_MODEL"); pb=$(model_b "$POD_MODEL"); lb=${lb:-0}; pb=${pb:-0}
  if [ "$tier" = large ] && [ "$pb" -gt "$lb" ] && [ "$lb" -le "$LOCAL_MAX_B" ]; then
    echo "pick: large task -> pod $(fmt_model "$POD_MODEL"); local tops out at $(fmt_model "$LOCAL_MODEL")"
    st=$(pod_state)
    if [ "$st" != running ]; then echo "  pod not running; starting on demand..."; pod_start; fi
    set_backend runpod; beat
    echo "  LLM_BACKEND=runpod. Endpoint warms up in a few minutes (ai-backend status)."
  else
    echo "pick: $tier task -> local $(fmt_model "$LOCAL_MODEL")"
    ollama_has "$LOCAL_MODEL" || echo "  note: local model missing; run 'make models' to pull it"
    set_backend local; beat
    echo "  LLM_BACKEND=local."
  fi
}

cmd_watch() {
  local once=0; [ "${1:-}" = --once ] && once=1
  echo "watching: pod auto-stops after ${IDLE_MINUTES}m idle (ctrl-c to quit)"
  while true; do
    if [ "$(pod_state)" = running ] && [ "$(idle_seconds)" -gt $((IDLE_MINUTES*60)) ]; then
      echo "$(date '+%H:%M:%S') idle > ${IDLE_MINUTES}m -> stopping pod, backend -> local"
      pod_stop; set_backend local
    fi
    [ "$once" = 1 ] && break
    sleep 60
  done
}

case "${1:-status}" in
  status)     shift; cmd_status "$@" ;;
  pick)       shift; cmd_pick "$@" ;;
  beat)       beat ;;
  watch)      shift; cmd_watch "$@" ;;
  stop)       pod_stop; set_backend local; echo "pod stopped; billing paused" ;;
  recommend)  shift; echo "task: ${1:-<none>}"; echo "suggest: $(recommend_tool "${1:-}")" ;;
  -h|--help|help) sed -n '9,24p' "$0" ;;
  *) echo "unknown: $1 (see --help)" >&2; exit 2 ;;
esac

