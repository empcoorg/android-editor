<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/tagline"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_claims"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/claimRam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ram"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/claimStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_storage"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/claimScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_screen"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/claimAndroid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_android"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/claimImei"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_imei"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/header_checks"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_check" />

        <Button
            android:id="@+id/btnUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_usb" />

        <EditText
            android:id="@+id/usbModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_usb_model"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/header_report"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPdf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/generate_pdf" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/share_pdf" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/header_preview"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
